# FlowRad Viewer — environment. Copy to .env.local for development. No secret values here.
# Full reference: docs/VIEWER_SAAS.md.

# ---------------------------------------------------------------------------
# Identity (lib/cloud/session.ts)
# ---------------------------------------------------------------------------
# Session cookie HMAC key. REQUIRED in production (openssl rand -base64 48).
SESSION_SECRET=
# Identity Platform web config (public by design; the server verifies ID tokens).
IDENTITY_PROJECT_ID=
IDENTITY_API_KEY=
# IDENTITY_AUTH_DOMAIN=<project>.firebaseapp.com
# Local only: email-only sign-in with no password. Ignored on Cloud Run.
# VIEWER_DEV_SIGN_IN=1

# ---------------------------------------------------------------------------
# Store (lib/cloud/store.ts). Firestore in production; JSON file locally.
# ---------------------------------------------------------------------------
# FIRESTORE_PROJECT=
# FIRESTORE_DATABASE=(default)
# VIEWER_STORE_FILE=.data/viewer-store.json

# ---------------------------------------------------------------------------
# Desktop downloads (lib/cloud/downloads.ts)
# ---------------------------------------------------------------------------
# DOWNLOADS_MANIFEST_URL=https://storage.googleapis.com/<bucket>/desktop/downloads.json
# Leave unset ("coming soon") until desktop builds are signed and self-updating
# (docs/DESKTOP_RELEASE_READINESS.md). 1 = show download links for signed builds.
# DESKTOP_DOWNLOADS_LIVE=1
# PUBLIC_ORIGIN=https://viewer.flowrad.ai

# ---------------------------------------------------------------------------
# Imaging archive for stored studies (lib/cloud/archive.ts, lib/imagingBackend.ts)
# ---------------------------------------------------------------------------
# Orthanc base URL (no trailing slash). When unset, upload/admin Orthanc
# surfaces report "not configured" (storing studies answers 503).
# Local: http://127.0.0.1:8042 (docker compose -f docker-compose.orthanc.yml up -d)
# Fly private network: http://flowrad-orthanc.internal:8042
# Leave unset on Cloud Run when DICOMWEB_BACKEND=healthcare.
ORTHANC_URL=

# Orthanc Basic-auth (defaults shown). Match your Orthanc config.
# The local compose file uses flowrad/flowrad. Cloud Run Healthcare does not use these.
ORTHANC_USER=flowrad
ORTHANC_PASSWORD=

# ---------------------------------------------------------------------------
# Imaging backend. Unset = Orthanc when ORTHANC_URL is set, otherwise
# Healthcare when HEALTHCARE_PROJECT (or HEALTHCARE_DICOMWEB_URL) is set.
# Production Cloud Run sets healthcare explicitly.
# ---------------------------------------------------------------------------
# DICOMWEB_BACKEND=orthanc
# DICOMWEB_BACKEND=healthcare

# Cloud Healthcare API DICOM store (production Cloud Run, see deploy/gcp).
# HEALTHCARE_PROJECT=flowrad-viewer-prod
# HEALTHCARE_LOCATION=europe-west2
# HEALTHCARE_DATASET=flowrad-viewer
# HEALTHCARE_DICOM_STORE=studies
# Full dicomWeb root, no trailing slash. Overrides the four ids above.
# HEALTHCARE_DICOMWEB_URL=
# Optional laptop smoke test. Production uses the Cloud Run metadata server.
# GOOGLE_ACCESS_TOKEN=

# Pixel path (app/api/dicomweb, docs/VIEWER_BENCHMARK.md §6).
# Transfer syntax the proxy asks the archive for when the viewer accepts any:
#   jls (lossless JPEG-LS, ~3.2x fewer bytes) | htj2k | j2k | original.
# Default: jls on Cloud Healthcare, original on Orthanc. A refusal falls back
# to the stored syntax for that series automatically.
# DICOMWEB_FRAME_TRANSFER_SYNTAX=jls
# In-process frame/index cache (L1), MB. 0 disables. R2/GCS below is L2.
# FRAME_MEMORY_CACHE_MB=64
# How long a cache read runs alone before the archive request also starts
# (hedged — a later cache hit still wins). FRAME_CACHE_WAIT_MS is the old name.
# FRAME_CACHE_HEDGE_MS=120
# Slim series index freshness, ms (a series that gains instances shows them after this).
# SERIES_INDEX_TTL_MS=3600000


# ---------------------------------------------------------------------------
# Frame cache for /api/dicomweb (optional). S3-compatible client: on GCP point
# R2_ENDPOINT at GCS with HMAC keys. Cloudflare R2 also works but is not used.
# ---------------------------------------------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=
# GCS S3-compatible endpoint for the same client (Cloud Run frame cache).
# When set, R2_ACCOUNT_ID is unused. Leave R2_PUBLIC_BASE_URL unset — frames
# are private and are only read by the app.
# R2_ENDPOINT=https://storage.googleapis.com
