# Google AI Studio (Gemini) API key — get one at https://aistudio.google.com/apikey
# ONE vendor, ONE key. Gemini does ALL model calls: dictation/voice STT, finding
# structuring, the web-grounded student tutor (tool-calling + Google Search), and
# text-to-speech for the tutor's spoken answers. If this is unset the app degrades
# gracefully — voice/tutor surfaces explain they're unavailable, and TTS falls back
# to the browser's built-in speechSynthesis.
GEMINI_API_KEY=

# Flash model to use. Override if you have access to a newer Flash model.
# Examples: gemini-flash-latest, gemini-2.5-flash, gemini-2.0-flash
GEMINI_MODEL=gemini-flash-latest

# Gemini TTS (tutor's spoken answers). Optional overrides — defaults shown.
# Voice options include Kore, Puck, Leda, Charon, etc. (see Gemini TTS docs).
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_TTS_VOICE=Kore

# ---------------------------------------------------------------------------
# Data store (optional). The data layer (lib/cases.ts) runs on JSON files under
# DATA_DIR by default. Set MONGODB_URI to silently switch the WHOLE app to
# MongoDB instead — no code changes. Leave it UNSET to keep JSON-on-volume.
# ---------------------------------------------------------------------------

# MongoDB connection string (e.g. a MongoDB Atlas SRV URI). When set, all cases/
# patients/studies persist to MongoDB; when unset, they persist to JSON files.
# Example: mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=

# Database name to use within the MongoDB cluster (default: flowrad).
MONGODB_DB=flowrad

# JSON store directory (used only when MONGODB_URI is unset). Point this at a
# Railway persistent Volume (e.g. /app/data) so cases survive redeploys.
# DATA_DIR=/app/data
