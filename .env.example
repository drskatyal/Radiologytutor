# Google AI Studio (Gemini) API key — get one at https://aistudio.google.com/apikey
# Orchestration / STT / tool-calling tutor + Gemini TTS fallback + Gemini Live.
# See docs/CONSULTANT_READING.md for the voice stack.
GEMINI_API_KEY=

# Per-request deadline for Gemini calls, ms (default 45000). Bounded + retried
# on 429/5xx in lib/gemini.ts so a hung upstream can't pin a server process.
GEMINI_TIMEOUT_MS=45000

# Flash model for orchestration + STT (default gemini-3.8-flash, stable GA).
GEMINI_MODEL=gemini-3.8-flash

# Gemini TTS fallback when no ElevenLabs clone is enrolled.
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_TTS_VOICE=Kore

# Gemini Live (realtime native audio) — latency fallback model id.
# Mint ephemeral tokens via POST /api/voice/realtime (never expose this key to the browser).
GEMINI_LIVE_MODEL=gemini-3.8-live

# Soft budget (ms) before the client should prefer Gemini Live over TTS.
VOICE_LATENCY_BUDGET_MS=1200

# ---------------------------------------------------------------------------
# ElevenLabs — cloned teacher voice for live tutor Q&A (Layer 3 only).
# Recorded walk-throughs always play the teacher's real mic — never clone.
# ---------------------------------------------------------------------------
ELEVENLABS_API_KEY=
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2

# ---------------------------------------------------------------------------
# Imaging backend — Orthanc DICOMweb (pixels). Cases/metadata live in the data
# store below; Orthanc holds the study bytes. The browser only ever hits
# /api/dicomweb (same-origin proxy) so creds stay server-side.
# ---------------------------------------------------------------------------

# Orthanc base URL (no trailing slash). When unset, upload/admin Orthanc
# surfaces report "not configured" and the student viewer falls back to the
# bundled sample study.
# Local: http://127.0.0.1:8042 (docker compose -f docker-compose.orthanc.yml up -d)
# Fly private network: http://flowrad-orthanc.internal:8042
# Leave unset on Cloud Run when DICOMWEB_BACKEND=healthcare.
ORTHANC_URL=

# Orthanc Basic-auth (defaults shown). Match your Orthanc config.
# The local compose file uses flowrad/flowrad. Cloud Run Healthcare does not use these.
ORTHANC_USER=flowrad
ORTHANC_PASSWORD=

# ---------------------------------------------------------------------------
# Imaging backend. Unset = Orthanc when ORTHANC_URL is set, otherwise
# Healthcare when HEALTHCARE_PROJECT (or HEALTHCARE_DICOMWEB_URL) is set.
# Production Cloud Run sets healthcare explicitly.
# ---------------------------------------------------------------------------
# DICOMWEB_BACKEND=orthanc
# DICOMWEB_BACKEND=healthcare

# Cloud Healthcare API DICOM store (production Cloud Run, project radlearn-app).
# HEALTHCARE_PROJECT=radlearn-app
# HEALTHCARE_LOCATION=europe-west2
# HEALTHCARE_DATASET=radlearn
# HEALTHCARE_DICOM_STORE=radlearn-dicom
# Full dicomWeb root, no trailing slash. Overrides the four ids above.
# HEALTHCARE_DICOMWEB_URL=
# Optional laptop smoke test. Production uses the Cloud Run metadata server.
# GOOGLE_ACCESS_TOKEN=

# Frame-cache read budget before the archive is called, ms. 0 skips the read.
# FRAME_CACHE_WAIT_MS=25

# ---------------------------------------------------------------------------
# Data store (optional). The data layer (lib/cases.ts) runs on JSON files under
# DATA_DIR by default. Set MONGODB_URI to silently switch the WHOLE app to
# MongoDB instead — no code changes. Leave it UNSET to keep JSON-on-volume.
# ---------------------------------------------------------------------------

# MongoDB connection string (e.g. a MongoDB Atlas SRV URI). When set, all cases/
# patients/studies persist to MongoDB; when unset, they persist to JSON files.
# Example: mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=

# Database name inside the cluster (app default: flowrad).
# Cloud Run sets MONGODB_DB=radlearn. JSON-on-disk is dev/test only; Cloud Run
# refuses to start the data layer without MONGODB_URI.
MONGODB_DB=flowrad

# JSON store directory (used only when MONGODB_URI is unset). Point this at a
# Fly volume (e.g. /app/data) so cases survive redeploys.
# DATA_DIR=/app/data

# ---------------------------------------------------------------------------
# Auth — Better Auth + optional Google OAuth (lib/auth.ts seam)
# Generate a secret: openssl rand -base64 32
# Demo/dev works without Google keys (email/password + "Continue as demo").
#
# REQUIRED IN PRODUCTION. With NODE_ENV=production and no value set, the app
# refuses to serve rather than fall back to a signing key that ships in the
# repo (which would make every session cookie forgeable).
# ---------------------------------------------------------------------------
BETTER_AUTH_SECRET=
# Public app URL used for OAuth callbacks and session cookies.
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Keyless "Continue as demo" sign-in. ON outside production, OFF in production
# unless you set this to 1 — left open it is a full authentication bypass.
# DEMO_AUTH_ENABLED=0

# When demo sign-in IS deliberately enabled in production (a public sandbox),
# this caps the *implicit* role (empty body / Continue as demo). Defaults to
# "student"; "author" is the maximum. Platform super-admin is never mintable.
# Teacher demo ({ role: "author" }) stays an author unless this is "student".
# DEMO_AUTH_MAX_ROLE=student

# ---------------------------------------------------------------------------
# Cloudflare R2 — audio + cached DICOM frames (optional; local disk if unset)
# ---------------------------------------------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=
# GCS S3-compatible endpoint for the same client (Cloud Run frame cache).
# When set, R2_ACCOUNT_ID is unused. Leave R2_PUBLIC_BASE_URL unset — frames
# are private and are only read by the app.
# R2_ENDPOINT=https://storage.googleapis.com
