# Google AI Studio (Gemini) API key — get one at https://aistudio.google.com/apikey
# Gemini Flash does ALL model calls: dictation STT + finding structuring +
# the student tutor agent (tool-calling) + voice-question understanding.
GEMINI_API_KEY=

# Flash model to use. Override if you have access to a newer Flash model.
# Examples: gemini-flash-latest, gemini-2.5-flash, gemini-2.0-flash
GEMINI_MODEL=gemini-flash-latest

# ElevenLabs — tutor narration voice (speech OUTPUT). Get a key at elevenlabs.io.
# If unset, the app falls back to the browser's built-in speechSynthesis.
ELEVENLABS_API_KEY=
# Voice id (default is "Rachel"). Pick a voice in the ElevenLabs dashboard.
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL=eleven_turbo_v2_5
