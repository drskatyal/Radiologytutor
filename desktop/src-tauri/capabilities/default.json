{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The viewer window: native open/save dialogs, restart after update, update checks. No filesystem plugin — file bytes reach the renderer only through the dicom:// protocol, which serves files the user opened.",
  "windows": ["main", "viewer-*"],
  "permissions": [
    "core:default",
    "core:window:allow-set-fullscreen",
    "core:window:allow-is-fullscreen",
    "core:window:allow-set-title",
    "core:window:allow-close",
    "core:event:allow-emit",
    "core:event:allow-listen",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-message",
    "dialog:allow-ask",
    "process:allow-restart",
    "updater:default"
  ]
}
