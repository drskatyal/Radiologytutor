# Copy to a shell, fill in, then source it. Placeholders only — no real project or secrets.
#
#   cp deploy/gcp/env.example deploy/gcp/env.local
#   # edit deploy/gcp/env.local
#   set -a && source deploy/gcp/env.local && set +a
#   deploy/gcp/setup.sh
#   # add secret versions (see docs/GCP_CLOUD_RUN.md)
#   deploy/gcp/deploy-app.sh

# GCP project id. Example shape: flowrad-learn-prod
PROJECT_ID=your-gcp-project
# App, DICOM store, and frame bucket MUST share this region.
# us-east4 matches the current Fly region (iad / Ashburn).
# Use asia-south1 if learners are in India — and only that region for all three.
REGION=us-east4

SERVICE=flowrad-learn
DATASET=flowrad
STORE=flowrad-dicom
REPO=flowrad
SA_NAME=flowrad-app

# Globally unique. Example: flowrad-frames-your-gcp-project
# Leave empty to skip the GCS frame cache (Healthcare is still the pixel source).
FRAME_BUCKET=

MIN_INSTANCES=1
MAX_INSTANCES=10

# Public origin for Better Auth and the Google OAuth redirect.
# Leave empty on the first deploy; deploy-app.sh reads the Cloud Run URL and sets it.
BETTER_AUTH_URL=

MONGODB_DB=flowrad
GEMINI_MODEL=gemini-3.7-flash
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_TTS_VOICE=Kore
GEMINI_LIVE_MODEL=gemini-live-2.5-flash-native-audio
GEMINI_TIMEOUT_MS=45000
VOICE_LATENCY_BUDGET_MS=1200
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
FRAME_CACHE_WAIT_MS=25
