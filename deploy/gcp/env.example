# Copy to a shell, fill in secrets locally, then source it. No secret values here.
#
#   cp deploy/gcp/env.example deploy/gcp/env.local
#   # edit deploy/gcp/env.local — add secret values only in that gitignored file
#   set -a && source deploy/gcp/env.local && set +a
#   deploy/gcp/setup.sh
#   # add secret versions (see docs/GCP_CLOUD_RUN.md)
#   deploy/gcp/deploy-app.sh

# Live GCP project. Display name: RadLearn. The id "radlearn" was unavailable.
PROJECT_ID=radlearn-app
# App, DICOM store, Cloud NAT, and frame bucket MUST share this region.
# europe-west2 is London. Atlas uses the same metro: EUROPE_WEST_2.
REGION=europe-west2

SERVICE=radlearn
DATASET=radlearn
STORE=radlearn-dicom
REPO=radlearn
SA_NAME=radlearn-app

# Direct VPC egress. all-traffic sends Atlas (and everything else) through Cloud NAT
# so the cluster can allow a single IP. After Atlas Private Service Connect is up,
# set private-ranges-only so Healthcare and Gemini skip the NAT.
NETWORK=radlearn
SUBNET=radlearn-run
SUBNET_RANGE=10.8.0.0/24
VPC_EGRESS=all-traffic

# Globally unique. Example: radlearn-app-frames
# Leave empty to skip the GCS frame cache (Healthcare is still the pixel source).
FRAME_BUCKET=

MIN_INSTANCES=1
MAX_INSTANCES=10

# Public origin for Better Auth and the Google OAuth redirect.
# Leave empty on the first deploy; deploy-app.sh reads the Cloud Run URL and sets it.
BETTER_AUTH_URL=

# Cloud Run database name inside the Atlas cluster. Not the JSON store.
MONGODB_DB=radlearn
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_TTS_VOICE=Kore
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_TIMEOUT_MS=45000
VOICE_LATENCY_BUDGET_MS=1200
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
FRAME_CACHE_WAIT_MS=25
