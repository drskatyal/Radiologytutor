# Copy to terraform.tfvars (gitignored) and fill in. No secrets here.
project_id           = "flowrad-viewer-prod"
region               = "europe-west2"
firestore_location   = "europe-west2"
downloads_bucket     = "flowrad-viewer-downloads"
frame_bucket         = ""
identity_api_key     = ""
identity_auth_domain = "flowrad-viewer-prod.firebaseapp.com"
public_origin        = "https://viewer.flowrad.ai"
custom_domain        = ""
github_repository    = "drskatyal/flowrad-viewer"
